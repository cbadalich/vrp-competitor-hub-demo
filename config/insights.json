        "any ?time"
      ]
    },
    {
      "key": "faculty",
      "label": "Faculty and staff workload",
      "definition": "Less work, time or staffing for educators and facilitators.",
      "patterns": [
        "faculty (workload|bandwidth|time)",
        "without (adding |increasing |requiring )?(more )?(faculty|educators|instructors|staff)",
        "without scaling staff",
        "workload",
        "prep time",
        "(educators|faculty|instructors)[^.;]{0,30}(more )?efficient\\w*",
        "(fewer|less) (faculty|instructors?|staff)",
        "facilitator (time|hours)"
      ]
    },
    {
      "key": "evidence",
