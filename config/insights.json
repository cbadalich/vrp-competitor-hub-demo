        "shortages?",
        "(staff|nurse|employee|workforce) retention",
        "retain (staff|nurses|employees|talent)",
        "turnover",
        "onboard\\w*",
        "transition to practice",
        "recruit\\w*"
      ]
    },
    {
      "key": "ai_message",
      "label": "AI as a selling point",
      "definition": "AI named in the main promise or tagline.",
      "patterns": [
        "(?-i:\\bAI\\b)",
        "(?-i:\\bAi\\b)",
        "artificial intelligence"
      ]
    }
  ],
  "messaging_fields": [
    "value_proposition",
